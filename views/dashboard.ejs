<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ByteBistrô - Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #0f1115;
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-image: 
                radial-gradient(circle at 50% 0%, rgba(255, 107, 107, 0.05), transparent 50%);
        }

        header {
            background: rgba(255, 255, 255, 0.02);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding: 24px 48px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            backdrop-filter: blur(10px);
        }

        h1 {
            font-size: 22px;
            font-weight: 600;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-dot {
            width: 12px;
            height: 12px;
            background: #ff6b6b;
            border-radius: 50%;
            box-shadow: 0 0 10px rgba(255, 107, 107, 0.5);
        }

        .logout-btn {
            background: rgba(255, 255, 255, 0.05);
            color: #8b92a5;
            padding: 8px 16px;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.2s;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .logout-btn:hover {
            background: rgba(255, 107, 107, 0.1);
            color: #ff6b6b;
            border-color: rgba(255, 107, 107, 0.2);
        }

        main {
            padding: 48px;
            flex: 1;
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 32px;
        }

        .card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 32px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(10px);
        }

        .card h3 {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 24px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Forms */
        form {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        input {
            width: 100%;
            padding: 14px 16px;
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            color: #fff;
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            transition: all 0.2s;
            outline: none;
        }

        input::placeholder {
            color: #646b7a;
        }

        input:focus {
            border-color: #ff6b6b;
            background: rgba(255, 107, 107, 0.03);
        }

        button[type="submit"] {
            background: linear-gradient(135deg, #ff6b6b 0%, #ff4757 100%);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 10px;
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 8px;
            transition: all 0.2s;
            box-shadow: 0 4px 15px rgba(255, 107, 107, 0.2);
        }

        button[type="submit"]:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 107, 107, 0.3);
        }

        /* Lista de itens */
        ul {
            list-style: none;
            max-height: 300px;
            overflow-y: auto;
            padding-right: 8px;
        }

        ul::-webkit-scrollbar {
            width: 4px;
        }

        ul::-webkit-scrollbar-track {
            background: transparent;
        }

        ul::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
        }

        li {
            background: rgba(255, 255, 255, 0.03);
            margin-bottom: 12px;
            padding: 16px;
            border-radius: 10px;
            font-size: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid transparent;
            transition: all 0.2s;
        }

        li:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.08);
        }

        .category-badge {
            font-size: 12px;
            background: rgba(255, 255, 255, 0.1);
            color: #b4bccf;
            padding: 4px 10px;
            border-radius: 20px;
            font-weight: 500;
        }

        .empty-state {
            text-align: center;
            color: #646b7a;
            padding: 32px 0;
            font-size: 15px;
        }

        .kanban-section {
            margin-top: 48px;
        }

        .kanban-section h2 {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 24px;
            color: #fff;
        }

        .coming-soon {
            background: rgba(252, 163, 17, 0.05);
            border: 1px dashed rgba(252, 163, 17, 0.3);
            color: #fca311;
            padding: 24px;
            border-radius: 12px;
            font-size: 15px;
            text-align: center;
        }

        /* Kanban Board */
        .kanban-board {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
            overflow-x: auto;
            padding-bottom: 16px;
        }

        .kanban-column {
            background: rgba(255, 255, 255, 0.02);
            border-radius: 16px;
            padding: 16px;
            min-width: 250px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .kanban-column h3 {
            text-align: center;
            font-size: 16px;
            color: #fff;
            padding-bottom: 12px;
            border-bottom: 2px solid rgba(255, 255, 255, 0.05);
            margin-bottom: 0;
        }

        .kanban-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 16px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .kanban-card h4 {
            font-size: 15px;
            color: #fff;
            margin-bottom: 8px;
        }

        .kanban-card p {
            color: #8b92a5;
            font-size: 13px;
            margin-bottom: 12px;
        }

        .btn-advance {
            width: 100%;
            background: rgba(255, 255, 255, 0.05);
            color: #fca311;
            border: 1px solid rgba(252, 163, 17, 0.2);
            padding: 8px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s;
        }

        .btn-advance:hover {
            background: rgba(252, 163, 17, 0.1);
            color: #fff;
        }
    </style>
</head>
<body>
    <header>
        <h1><div class="logo-dot"></div> ByteBistrô</h1>
        <div style="display:flex; gap:16px; align-items:center;">
            <a href="/admin/export" style="background:#fca311; color:#0f1115; font-weight:600;" class="logout-btn">Baixar Relatório CSV</a>
            <a href="/" class="logout-btn">Sair da conta</a>
        </div>
    </header>

    <main>
        <div class="grid">
            <div class="card">
                <h3>Adicionar Ingrediente / Marmita</h3>
                <form action="/add-item" method="POST">
                    <input type="text" name="name" placeholder="Nome (Ex: Batata Doce)" required>
                    <input type="text" name="category" placeholder="Categoria (Ex: Carboidrato)">
                    <input type="number" step="0.01" min="0.01" name="price" placeholder="Preço (Ex: 15.50)" required>
                    <button type="submit">Cadastrar Item</button>
                </form>
            </div>

            <div class="card">
                <h3>Itens Disponíveis</h3>
                <ul>
                    <% if (items && items.length > 0) { %>
                        <% items.forEach(item => { %>
                            <li>
                                <span><%= item.name %></span>
                                <div style="display:flex; gap:8px; align-items:center;">
                                    <% if (item.price) { %>
                                        <span style="color:#fca311; font-weight:600;">R$ <%= parseFloat(item.price).toFixed(2) %></span>
                                    <% } %>
                                    <span class="category-badge"><%= item.category || 'Geral' %></span>
                                </div>
                            </li>
                        <% }) %>
                    <% } else { %>
                        <div class="empty-state">
                            Nenhum ingrediente cadastrado ainda.
                        </div>
                    <% } %>
                </ul>
            </div>
        </div>

        <div class="kanban-section">
            <h2>Registrar Nova Venda</h2>
            <div class="card" style="margin-bottom: 32px;">
                <form action="/orders" method="POST" style="flex-direction: row; align-items: flex-end; flex-wrap: wrap;">
                    <div style="flex: 1; min-width: 200px;">
                        <label style="display:block; margin-bottom:8px; font-size:13px; color:#8b92a5;">Nome do Cliente</label>
                        <input type="text" name="customer_name" placeholder="Ex: João Silva" required>
                    </div>
                    <div style="flex: 1; min-width: 200px;">
                        <label style="display:block; margin-bottom:8px; font-size:13px; color:#8b92a5;">Marmita Selecionada</label>
                        <select name="item_name" required style="width: 100%; padding: 14px 16px; background: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; color: #fff; font-family: 'Inter', sans-serif; font-size: 15px; outline: none;">
                            <option value="">Selecione uma marmita...</option>
                            <% if (items && items.length > 0) { %>
                                <% items.forEach(item => { %>
                                    <option value="<%= item.name %>"><%= item.name %> - R$ <%= parseFloat(item.price || 0).toFixed(2) %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <button type="submit" style="margin-top:0; height:47px;">Registrar Pedido</button>
                </form>
            </div>

            <h2>Painel Kanban da Cozinha</h2>
            <div class="kanban-board">
                <!-- Coluna: Aberto -->
                <div class="kanban-column">
                    <h3>Aberto</h3>
                    <% if (orders) { %>
                        <% orders.filter(o => o.status === 'Aberto').forEach(order => { %>
                            <div class="kanban-card" style="border-top: 4px solid #ff6b6b;">
                                <h4><%= order.customer_name %></h4>
                                <p><%= order.item_name %></p>
                                <form action="/orders/advance/<%= order.id %>" method="POST">
                                    <button type="submit" class="btn-advance">Avançar para Cozinha →</button>
                                </form>
                            </div>
                        <% }) %>
                    <% } %>
                </div>

                <!-- Coluna: Cozinha -->
                <div class="kanban-column">
                    <h3>Cozinha</h3>
                    <% if (orders) { %>
                        <% orders.filter(o => o.status === 'Cozinha').forEach(order => { %>
                            <div class="kanban-card" style="border-top: 4px solid #fca311;">
                                <h4><%= order.customer_name %></h4>
                                <p><%= order.item_name %></p>
                                <form action="/orders/advance/<%= order.id %>" method="POST">
                                    <button type="submit" class="btn-advance">Avançar para Entrega →</button>
                                </form>
                            </div>
                        <% }) %>
                    <% } %>
                </div>

                <!-- Coluna: Entrega -->
                <div class="kanban-column">
                    <h3>Entrega</h3>
                    <% if (orders) { %>
                        <% orders.filter(o => o.status === 'Entrega').forEach(order => { %>
                            <div class="kanban-card" style="border-top: 4px solid #4facfe;">
                                <h4><%= order.customer_name %></h4>
                                <p><%= order.item_name %></p>
                                <form action="/orders/advance/<%= order.id %>" method="POST">
                                    <button type="submit" class="btn-advance">Marcar como Entregue ✓</button>
                                </form>
                            </div>
                        <% }) %>
                    <% } %>
                </div>

                <!-- Coluna: Entregue -->
                <div class="kanban-column" style="opacity: 0.7;">
                    <h3>Entregue</h3>
                    <% if (orders) { %>
                        <% orders.filter(o => o.status === 'Entregue').forEach(order => { %>
                            <div class="kanban-card" style="border-top: 4px solid #00f2fe;">
                                <h4><%= order.customer_name %></h4>
                                <p><%= order.item_name %></p>
                                <!-- Sem botão de avançar na última etapa -->
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
