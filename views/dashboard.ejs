<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ByteBistrô - Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #0f1115;
            color: #ffffff;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-image: 
                radial-gradient(circle at 50% 0%, rgba(255, 107, 107, 0.05), transparent 50%);
        }

        header {
            background: rgba(255, 255, 255, 0.02);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding: 24px 48px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            backdrop-filter: blur(10px);
        }

        h1 {
            font-size: 22px;
            font-weight: 600;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-dot {
            width: 12px;
            height: 12px;
            background: #ff6b6b;
            border-radius: 50%;
            box-shadow: 0 0 10px rgba(255, 107, 107, 0.5);
        }

        .logout-btn {
            background: rgba(255, 255, 255, 0.05);
            color: #8b92a5;
            padding: 8px 16px;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.2s;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .logout-btn:hover {
            background: rgba(255, 107, 107, 0.1);
            color: #ff6b6b;
            border-color: rgba(255, 107, 107, 0.2);
        }

        main {
            padding: 48px;
            flex: 1;
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 32px;
        }

        .card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 32px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(10px);
        }

        .card h3 {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 24px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Forms */
        form {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        input {
            width: 100%;
            padding: 14px 16px;
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            color: #fff;
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            transition: all 0.2s;
            outline: none;
        }

        input::placeholder {
            color: #646b7a;
        }

        input:focus {
            border-color: #ff6b6b;
            background: rgba(255, 107, 107, 0.03);
        }

        button[type="submit"] {
            background: linear-gradient(135deg, #ff6b6b 0%, #ff4757 100%);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 10px;
            font-family: 'Inter', sans-serif;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 8px;
            transition: all 0.2s;
            box-shadow: 0 4px 15px rgba(255, 107, 107, 0.2);
        }

        button[type="submit"]:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 107, 107, 0.3);
        }

        /* Lista de itens */
        ul {
            list-style: none;
            max-height: 300px;
            overflow-y: auto;
            padding-right: 8px;
        }

        ul::-webkit-scrollbar {
            width: 4px;
        }

        ul::-webkit-scrollbar-track {
            background: transparent;
        }

        ul::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
        }

        li {
            background: rgba(255, 255, 255, 0.03);
            margin-bottom: 12px;
            padding: 16px;
            border-radius: 10px;
            font-size: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid transparent;
            transition: all 0.2s;
        }

        li:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.08);
        }

        .category-badge {
            font-size: 12px;
            background: rgba(255, 255, 255, 0.1);
            color: #b4bccf;
            padding: 4px 10px;
            border-radius: 20px;
            font-weight: 500;
        }

        .empty-state {
            text-align: center;
            color: #646b7a;
            padding: 32px 0;
            font-size: 15px;
        }

        .kanban-section {
            margin-top: 48px;
        }

        .kanban-section h2 {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 24px;
            color: #fff;
        }

        .coming-soon {
            background: rgba(252, 163, 17, 0.05);
            border: 1px dashed rgba(252, 163, 17, 0.3);
            color: #fca311;
            padding: 24px;
            border-radius: 12px;
            font-size: 15px;
            text-align: center;
        }
    </style>
</head>
<body>
    <header>
        <h1><div class="logo-dot"></div> ByteBistrô</h1>
        <a href="/" class="logout-btn">Sair da conta</a>
    </header>

    <main>
        <div class="grid">
            <div class="card">
                <h3>Adicionar Ingrediente</h3>
                <form action="/add-item" method="POST">
                    <input type="text" name="name" placeholder="Nome (Ex: Batata Doce)" required>
                    <input type="text" name="category" placeholder="Categoria (Ex: Carboidrato)">
                    <button type="submit">Cadastrar Item</button>
                </form>
            </div>

            <div class="card">
                <h3>Itens Disponíveis</h3>
                <ul>
                    <% if (items && items.length > 0) { %>
                        <% items.forEach(item => { %>
                            <li>
                                <span><%= item.name %></span>
                                <span class="category-badge"><%= item.category || 'Geral' %></span>
                            </li>
                        <% }) %>
                    <% } else { %>
                        <div class="empty-state">
                            Nenhum ingrediente cadastrado ainda.
                        </div>
                    <% } %>
                </ul>
            </div>
        </div>

        <div class="kanban-section">
            <h2>Pedidos Ativos</h2>
            <div class="coming-soon">
                Sistema de Kanban e controle de pedidos será disponibilizado na próxima atualização.
            </div>
        </div>
    </main>
</body>
</html>
